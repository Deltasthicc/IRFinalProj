# Copy to .env (which is git-ignored) and fill in. Never commit .env.

# Which LLM backend: gemini | anthropic | openai | stub
#   gemini    = Google Gemini API (key from https://aistudio.google.com/apikey);
#   anthropic = Anthropic API; openai = any OpenAI-compatible endpoint (also a local Ollama);
#   stub      = development only, quotes a passage instead of calling a model (eval scripts refuse it)
LLM_PROVIDER=stub
# Model name; leave empty for the provider default (see src/trademesh/rag/llm.py)
LLM_MODEL=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama in Docker: http://ollama:11434/v1   (on the host: http://localhost:11434/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Answer cache (every call is cached on disk by hash of model + prompt)
LLM_CACHE_DIR=cache/llm
# 1 = never call the network; a cache miss is an error (use for the offline demo)
LLM_OFFLINE=0
# Hard cap on live (uncached) calls per process
LLM_MAX_LIVE_CALLS=200
